generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Użytkownik Discord (panel + odniesienia w case'ach)
model User {
  id            String   @id @default(cuid())
  discordId     String   @unique
  username      String
  discriminator String?  @default("0")
  avatar        String?
  email         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts Account[]
  sessions Session[]
  modCases ModCase[] @relation("ModCaseTarget")
  modActions ModCase[] @relation("ModCaseModerator")
}

/// Konta OAuth (Auth.js / NextAuth)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Serwer Discord, na którym jest bot
model Guild {
  id        String   @id @default(cuid())
  discordId String   @unique
  name      String
  icon      String?
  ownerId   String?
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings GuildSettings?
  modCases ModCase[]
}

/// Ustawienia guild (panel + bot)
model GuildSettings {
  id                 String  @id @default(cuid())
  guildId            String  @unique
  locale             String  @default("pl")
  moderationEnabled  Boolean @default(true)
  /// Kanał logów moderacji (placeholder — pełne logging w Phase 2)
  modLogChannelId    String?
  /// Rola z uprawnieniami moderatorskimi (opcjonalnie, poza Discord perms)
  moderatorRoleId    String?
  muteDefaultMinutes Int     @default(60)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

enum ModAction {
  WARN
  MUTE
  KICK
  BAN
  UNMUTE
  UNBAN
}

/// Historia spraw moderacyjnych
model ModCase {
  id          String    @id @default(cuid())
  caseNumber  Int
  guildId     String
  action      ModAction
  reason      String?
  /// Discord snowflake celu
  targetDiscordId String
  targetUserId    String?
  /// Discord snowflake moderatora
  moderatorDiscordId String
  moderatorUserId    String?
  /// Czas trwania mute w minutach (jeśli dotyczy)
  durationMinutes Int?
  createdAt   DateTime  @default(now())

  guild     Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  target    User? @relation("ModCaseTarget", fields: [targetUserId], references: [id])
  moderator User? @relation("ModCaseModerator", fields: [moderatorUserId], references: [id])

  @@unique([guildId, caseNumber])
  @@index([guildId, createdAt])
  @@index([targetDiscordId])
}
