# === Discord Bot ===
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Publiczny URL panelu (lokalnie: http://localhost:3000)
# Redirect OAuth w Discord Developer Portal: {NEXTAUTH_URL}/api/auth/callback/discord
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=zmien-na-dlugi-losowy-string

# === Baza danych ===
# docker compose up -d → Postgres na porcie 5432
DATABASE_URL=postgresql://discordbot:discordbot@localhost:5432/discordbot?schema=public

# === Bot (opcjonalne) ===
# NODE_ENV=development
# LOG_LEVEL=info
