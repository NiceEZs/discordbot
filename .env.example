# === Discord Bot ===
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Publiczny URL panelu — MUSI być dokładnie tym samym hostem/portem, pod którym
# otwierasz panel w przeglądarce (bez końcowego /).
# Przykłady:
#   http://localhost:3001
#   http://192.168.55.48:3001
# NextAuth v4 (nie Auth.js v5): używaj NEXTAUTH_* — nie AUTH_URL / AUTH_SECRET / AUTH_TRUST_HOST.
# Redirect OAuth w Discord Developer Portal (dokładnie 1:1):
#   {NEXTAUTH_URL}/api/auth/callback/discord
#   np. http://192.168.55.48:3001/api/auth/callback/discord
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=zmien-na-dlugi-losowy-string

# === Baza danych ===
# docker compose up -d → Postgres na porcie 5432
DATABASE_URL=postgresql://discordbot:discordbot@localhost:5432/discordbot?schema=public

# === Bot (opcjonalne) ===
# NODE_ENV=development
# LOG_LEVEL=info
