[Unit]
Description=Nice HVH Discord bot
Documentation=https://github.com/NiceEZs/discordbot
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=nice
Group=nice
WorkingDirectory=/home/nice/discordbot
# systemd nie rozwija ~ — pełna ścieżka do .env (sekrety NIE w repo)
EnvironmentFile=/home/nice/discordbot/.env
Environment=NODE_ENV=production
ExecStart=/home/nice/discordbot/scripts/prod-start-bot.sh
Restart=always
RestartSec=5
# Logi: journalctl -u discordbot-bot -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=discordbot-bot

# Bezpieczeństwo (łagodne — Node/nvm muszą działać w HOME)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
